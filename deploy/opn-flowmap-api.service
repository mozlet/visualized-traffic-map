[Unit]
Description=OPNsense traffic map API (axum + WebSocket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mozlet
WorkingDirectory=/opt/opn-flowmap
EnvironmentFile=/etc/default/opn-flowmap
Environment=API_BIND=0.0.0.0:8088
Environment=FRONTEND_DIR=/opt/opn-flowmap/web
ExecStart=/opt/opn-flowmap/bin/api
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
