PG_USER=flowmap
PG_PASSWORD=flowmap
PG_DB=flowmap
PG_PORT=5432

REDIS_PORT=6379

# Data persists in docker/podman named volumes (pgdata, redisdata).
DATABASE_URL=postgres://flowmap:flowmap@127.0.0.1:5432/flowmap
REDIS_URL=redis://127.0.0.1:6379

OPNSENSE_SSH_HOST=opnsense
OPNSENSE_FLOWD_LOG=/var/log/flowd.log

# MaxMind GeoLite2 (free license key: https://www.maxmind.com/en/geolite2/signup)
MAXMIND_LICENSE_KEY=
GEOIP_DB_DIR=data/geoip
GEOIP_DB_PATH=data/geoip/GeoLite2-City.mmdb

# Home coordinate for private/LAN addresses (OPNsense site location).
# Default below is a placeholder — set to your actual location.
HOME_LAT=0.0
HOME_LON=0.0
